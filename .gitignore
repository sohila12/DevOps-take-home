# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable files may contain secrets — ignore them, but keep example files
# so the repo documents what variables are expected.
*.tfvars
*.tfvars.json
!*.tfvars.example

# .terraform.lock.hcl is intentionally NOT ignored. Terraform recommends
# committing it so provider version selection is reproducible across
# machines and CI runs — do not add it to this file.

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
